rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Helper function to check if user is teacher
    function isTeacher() {
      return request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if isAdmin() || request.auth.uid == userId;
    }

    match /sections/{sectionId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /students/{studentId} {
      // Allow admins full read/write
      // Allow teachers to read/write if the student's section is in their assignedSections
      allow read: if isAdmin() || (isTeacher() && resource.data.sectionId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedSections);
      allow create, update: if isAdmin() || (isTeacher() && request.resource.data.sectionId in get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedSections);
      allow delete: if isAdmin();
    }
  }
}
